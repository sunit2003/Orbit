{
  "expo": {
    "name": "Orbit Expense Tracker",
    "slug": "Orbit Expense Tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/orbitIcon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/orbitIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Orbit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/orbit_splash_new.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Gilroy-Bold.ttf",
            "./assets/fonts/Gilroy-Heavy.ttf",
            "./assets/fonts/Gilroy-Light.ttf",
            "./assets/fonts/Gilroy-Medium.ttf",
            "./assets/fonts/Gilroy-Regular.ttf",
            "./assets/fonts/Gilroy-SemiBold.ttf"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
